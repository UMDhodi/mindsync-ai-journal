rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all access to unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security assertions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(field) {
      return request.resource.data[field] is timestamp || request.resource.data[field] is string;
    }

    // Strict multi-tenant isolation under /users/{userId}
    match /users/{userId} {
      // User Profile document
      allow read, write: if isOwner(userId);

      // Journal & Brainstorming Sessions
      match /sessions/{sessionId} {
        allow read, write, delete: if isOwner(userId);

        // Messages within a session
        match /messages/{messageId} {
          allow read, write, delete: if isOwner(userId);
        }
      }

      // Automated Summaries & MindSync Cognitive Insights
      match /summaries/{summaryId} {
        allow read, write, delete: if isOwner(userId);
      }

      // Concept Knowledge Graph Nodes & Links
      match /graphs/{graphId} {
        allow read, write, delete: if isOwner(userId);
      }

      // Audit logs (Read-only for user, system writes)
      match /audit_logs/{logId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }
  }
}
